# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umkm_desa?schema=public"

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-random-32-byte"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment gateway aktif: tripay | ipaymu | manual
PAYMENT_GATEWAY="manual"

# Tripay (https://tripay.co.id)
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_SANDBOX="true"

# iPaymu (https://ipaymu.com)
IPAYMU_VA=""
IPAYMU_API_KEY=""
IPAYMU_SANDBOX="true"

# Ongkir flat antar wilayah (rupiah)
NEXT_PUBLIC_FLAT_SHIPPING_FEE="5000"

# Password admin awal untuk `npm run db:seed` (GANTI di produksi!)
SEED_ADMIN_PASSWORD="admin123"

# Password Postgres untuk docker compose (GANTI di produksi!)
POSTGRES_PASSWORD="postgres"
