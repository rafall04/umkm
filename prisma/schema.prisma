generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Desa ────────────────────────────────────────────────────────────────────

model Village {
  id          String   @id @default(cuid())
  slug        String   @unique // "dander" | "tanjungharjo"
  name        String // "Desa Dander"
  kecamatan   String
  kabupaten   String   @default("Bojonegoro")
  provinsi    String   @default("Jawa Timur")
  description String   @db.Text
  heroImage   String?
  lat         Float?
  lng         Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins   User[]
  vendors  Vendor[]
  products Product[]

  @@map("villages")
}

// ─── Pengguna ────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN_DESA
  VENDOR
  BUYER
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  name         String
  passwordHash String?
  role         Role     @default(BUYER)
  villageId    String? // scope untuk ADMIN_DESA
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  village Village? @relation(fields: [villageId], references: [id])
  vendor  Vendor? // toko yang dimiliki (role VENDOR)
  orders  Order[]

  @@map("users")
}

// ─── UMKM / Vendor ───────────────────────────────────────────────────────────

model Vendor {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  logo        String?
  banner      String?
  ownerId     String   @unique
  villageId   String
  phone       String?
  whatsapp    String?
  address     String   @db.Text
  qrisImage   String? // QRIS statis milik toko (diupload vendor)
  isVerified  Boolean  @default(false) // verifikasi oleh admin desa
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id])
  village    Village     @relation(fields: [villageId], references: [id])
  products   Product[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([villageId, isActive])
  @@map("vendors")
}

// ─── Kategori & Produk ───────────────────────────────────────────────────────

model Category {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  icon     String?

  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String   @db.Text
  price          Int // rupiah
  compareAtPrice Int? // harga coret (harga normal sebelum diskon)
  stock          Int      @default(0)
  unit           String   @default("pcs") // pcs, kg, paket, porsi
  images         String[]
  villageId      String
  vendorId       String
  categoryId     String
  isActive       Boolean  @default(true)
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  village    Village          @relation(fields: [villageId], references: [id])
  vendor     Vendor           @relation(fields: [vendorId], references: [id])
  category   Category         @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  variants   ProductVariant[]
  reviews    Review[]

  @@index([villageId, isActive])
  @@index([vendorId])
  @@index([categoryId])
  @@map("products")
}

// Varian produk (rasa/ukuran/warna). Harga boleh null → pakai harga produk.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String // "Pedas", "500 gram", "Merah"
  price     Int? // override harga; null = harga produk
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ─── Pesanan ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING // menunggu pembayaran
  PAID // sudah dibayar, menunggu diproses vendor
  PROCESSING
  DELIVERED // sedang/selesai dikirim
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  GATEWAY // Tripay/iPaymu (QRIS, VA, e-wallet)
  TRANSFER // transfer manual + upload bukti
  COD // bayar di tempat
}

enum PaymentStatus {
  UNPAID
  PENDING // menunggu konfirmasi (transfer manual)
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum DeliveryMethod {
  COD // dibayar & diserahkan di tempat
  ANTAR_DESA // diantar, ongkir flat
  AMBIL_SENDIRI // pembeli ambil di lokasi UMKM
}

enum VendorItemStatus {
  MENUNGGU
  DIPROSES
  DIKIRIM
  SELESAI
  DIBATALKAN
}

model Order {
  id             String         @id @default(cuid())
  code           String         @unique // ORD-20261003-XXXX
  buyerId        String?
  buyerName      String
  buyerPhone     String
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod
  paymentChannel String? // qris, BCA, dsb (dari gateway)
  paymentStatus  PaymentStatus  @default(UNPAID)
  paymentRef     String? // reference dari gateway
  paymentUrl     String? // halaman pembayaran gateway
  paymentProof   String? // foto bukti bayar (TRANSFER/QRIS ke toko)
  paidAt         DateTime?
  deliveryMethod DeliveryMethod
  addressText    String         @db.Text
  note           String?
  subtotal       Int
  shippingFee    Int            @default(0)
  total          Int
  expiredAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  buyer       User?                @relation(fields: [buyerId], references: [id])
  items       OrderItem[]
  paymentLogs PaymentLog[]
  history     OrderStatusHistory[]

  @@index([buyerPhone])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String           @id @default(cuid())
  orderId      String
  vendorId     String
  productId    String
  variantId    String? // varian yang dipilih (null = produk tanpa varian)
  productName  String // snapshot
  variantName  String? // snapshot nama varian
  productImage String?
  price        Int // snapshot harga saat checkout
  qty          Int
  subtotal     Int
  vendorStatus VendorItemStatus @default(MENUNGGU)
  deliveredAt  DateTime? // kapan item berstatus DIKIRIM — untuk auto-complete

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor  Vendor          @relation(fields: [vendorId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  review  Review?

  @@index([orderId])
  @@index([vendorId, vendorStatus])
  @@map("order_items")
}

// Audit trail perubahan status order — dicatat di setiap transisi.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String? // "Bukti transfer disetujui", "Otomatis: tidak dikirim 3 hari"
  actor     String? // "buyer" | "vendor:<id>" | "admin:<id>" | "system" | "gateway:<nama>"
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Ulasan pembeli — 1 per item order, membuktikan transaksi sungguhan.
model Review {
  id          String      @id @default(cuid())
  orderItemId String      @unique // satu ulasan per item
  productId   String
  vendorId    String
  rating      Int // 1-5
  comment     String      @db.Text
  buyerName   String
  isPublished Boolean     @default(true) // admin bisa sembunyikan
  createdAt   DateTime    @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id])

  @@index([productId, isPublished])
  @@map("reviews")
}

model PaymentLog {
  id        String   @id @default(cuid())
  orderId   String
  gateway   String // "tripay" | "ipaymu" | "manual"
  event     String // "callback" | "status_check" | "created"
  payload   Json
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_logs")
}

